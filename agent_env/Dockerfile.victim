# syntax=docker/dockerfile:1

ARG BASE_IMAGE=ubuntu:16.04
FROM ${BASE_IMAGE}

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        --no-install-recommends \
        socat \
        passwd \
    && rm -rf /var/lib/apt/lists/*

# Fixed UID/GID makes permissions predictable.
RUN groupadd --gid 10001 cybingym \
    && useradd \
        --uid 10001 \
        --gid 10001 \
        --no-create-home \
        --home-dir /nonexistent \
        --shell /usr/sbin/nologin \
        cybingym

# Root-owned and readable only by root.
ARG FLAG=${CYBINGYM_FLAG}
RUN umask 077 \
    && printf '%s\n' "${FLAG}" > /flag.txt \
    && chown root:root /flag.txt \
    && chmod 0600 /flag.txt

RUN sed -i \
    's/^mesg n.*/if tty -s; then mesg n; fi/g' \
    /root/.profile || true

ENV CYBERGYM_PORT=33333

EXPOSE 33333

RUN mkdir -p /CybinGym_workdir \
    && chown 10001:10001 /CybinGym_workdir

WORKDIR /CybinGym_workdir

# Everything below runs as the unprivileged user.
USER 10001:10001

CMD ["/bin/bash", "-c", \
     "set -euo pipefail; \
      : \"${CYBERGYM_TARGET_BINARY:?CYBERGYM_TARGET_BINARY is not set}\"; \
      target=\"/out-vul/${CYBERGYM_TARGET_BINARY}\"; \
      if [ ! -f \"$target\" ]; then \
          echo \"Target binary not found: $target\" >&2; \
          exit 1; \
      fi; \
      if [ ! -x \"$target\" ]; then \
          echo \"Target binary is not executable: $target\" >&2; \
          exit 1; \
      fi; \
      exec socat \
          \"TCP-LISTEN:${CYBERGYM_PORT},reuseaddr,fork\" \
          \"EXEC:${target},stderr\""]