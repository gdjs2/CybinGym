ARG BASE_IMAGE=ubuntu:16.04

FROM ${BASE_IMAGE}

ARG FLAG=${CYBINGYM_FLAG}

RUN printf '%s\n' "${FLAG}" > /flag.txt \
    && chmod 644 /flag.txt

RUN sed -i 's/^mesg n.*/if tty -s; then mesg n; fi/g' /root/.profile || true

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive \
       apt-get install -y --no-install-recommends socat \
    && rm -rf /var/lib/apt/lists/*
    
# Default TCP port. Override with: -e CYBERGYM_PORT=<port>
ENV CYBERGYM_PORT=33333

EXPOSE 33333

WORKDIR /CybinGym_workdir

# Inspect automatically sets the working directory and mounts the files.
#
# The target binary is expected at:
#   /out-vul/$CYBERGYM_TARGET_BINARY
#
# Each TCP connection starts a new instance of the target binary.
CMD ["/bin/bash", "-c", \
     "set -euo pipefail; \
      : \"${CYBERGYM_TARGET_BINARY:?CYBERGYM_TARGET_BINARY is not set}\"; \
      target=\"/out-vul/${CYBERGYM_TARGET_BINARY}\"; \
      if [ ! -f \"$target\" ]; then \
          echo \"Target binary not found: $target\" >&2; \
          exit 1; \
      fi; \
      chmod +x \"$target\"; \
      exec socat \
          TCP-LISTEN:${CYBERGYM_PORT},reuseaddr,fork \
          EXEC:\"$target\",stderr"]